# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_CHAT_MODEL: Optional. Defaults to the lowest-cost Gemini chat model.
GEMINI_CHAT_MODEL="gemini-2.5-flash-lite"

# Chat cost controls. Defaults target a monthly cap of about 1,000 JPY.
CHAT_MONTHLY_BUDGET_JPY="1000"
CHAT_USD_JPY_RATE="160"
# How long recent Q&A pairs are kept for the admin analytics dashboard. The user's own
# free-text question is stored (lightly redacted — see README) and can contain their
# name or address, so treat this value as a real data-retention/privacy setting, not
# just a storage-size knob. Lower it (e.g. "7") if a shorter window is preferred.
CHAT_RECENT_MESSAGE_RETENTION_DAYS="365"
# Max number of Q&A pairs retained (rolling) and shown in the admin dashboard.
CHAT_RECENT_MESSAGE_LIMIT="1000"
CHAT_ANALYTICS_DISPLAY_LIMIT="100"

# Vercel production storage for chat budget/analytics.
# Configure Vercel KV / Upstash Redis and set either KV_* or UPSTASH_* variables.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Required token to view /api/chat/usage, /api/chat/analytics, and /admin/chat-analytics.
# Admin dashboard uses this token through a login form and httpOnly cookie.
# API access may also use Authorization: Bearer <token>.
CHAT_ANALYTICS_TOKEN=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GAS_WEBAPP_URL: Optional Google Apps Script web application deployment URL
GAS_WEBAPP_URL=""

# GAS_SHARED_SECRET: Shared secret sent to the GAS web app as `token` on every form
# submission. The GAS URL itself is not secret once deployed (anyone who has it can
# call it directly, bypassing this server's rate limiting/validation), so set this
# AND the matching "SHARED_SECRET" Script Property in the Apps Script editor
# (Project Settings > Script Properties) to require every request to authenticate.
# Leaving it unset preserves the previous unauthenticated behavior.
GAS_SHARED_SECRET=""
